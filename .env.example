# Hannibal V2 Environment Variables

# Database
DATABASE_URL=postgresql+psycopg2://hannibal:hannibal@localhost:5432/hannibal

# API
SECRET_KEY=hannibal-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=hannibal-documents

# Redis (for background work)
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000