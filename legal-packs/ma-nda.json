    {"title": "Confidentiality", "clause_type": "mandatory", "contract_type": "nda", "content": "The Receiving Party agrees not to disclose or use Confidential Information except for [Purpose]. Demo sample — legal review required.", "description": "Confidential information protection"},
    {"title": "NDA term", "clause_type": "mandatory", "contract_type": "nda", "content": "The obligations of confidentiality survive for five (5) years after the termination of this NDA. Demo sample — legal review required.", "description": "Term and survival"},
